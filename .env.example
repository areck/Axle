# Axle local configuration.
#
# Every value below is OPTIONAL — Axle runs with sensible defaults and requires
# no configuration for local development. Copy to `.env` only if you want to
# override something.

# --- API (control plane) ---
AXLE_API_HOST=127.0.0.1
AXLE_API_PORT=8787

# Base URL the CLI uses to reach the API.
AXLE_API_URL=http://127.0.0.1:8787

# --- Storage ---
# Directory (relative to repo root, or absolute) where Axle keeps its SQLite
# database and execution artifacts.
AXLE_HOME=.axle

# --- Runtime ---
# Which execution runtime to use:
#   local  -> LocalRuntime  (ephemeral temp-dir subprocess; NO isolation; dev only)
#   docker -> DockerRuntime (isolated container; not yet implemented in this pass)
# When unset, Axle uses Docker if a daemon is reachable, otherwise Local.
AXLE_RUNTIME=local
