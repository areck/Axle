# Axle local configuration.
#
# Use this file as an environment checklist. The processes read values from the
# shell; export them directly or load this file with your preferred env tool.

# Required bearer token shared by the API and CLI.
# Generate with: openssl rand -hex 32
AXLE_API_TOKEN=

# Required 32-byte base64 key shared by the API and worker.
# Generate with: openssl rand -base64 32
AXLE_SECRET_KEY=

# --- API (control plane) ---
AXLE_API_HOST=127.0.0.1
AXLE_API_PORT=8787

# Base URL the CLI uses to reach the API.
AXLE_API_URL=http://127.0.0.1:8787

# --- Storage ---
# Directory (relative to repo root, or absolute) where Axle keeps its SQLite
# database and execution artifacts.
AXLE_HOME=.axle

# --- Runtime ---
# The current bootstrap has one working provider:
#   local -> LocalRuntime (L0 host subprocess; NO isolation; development only)
#
# Select it explicitly while the legacy automatic selector is still present.
# The next runtime model uses workload requirements and verified provider
# capabilities; autonomous work will require an L3 microVM provider and will
# never fall back silently to LocalRuntime.
AXLE_RUNTIME=local
